---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks!">
  <section class="container-x grid min-h-[80svh] place-content-center text-center">
    <h1 class="display text-7xl sm:text-9xl">Thank you<span class="text-accent">.</span></h1>
    <p class="mt-6 text-xl">Your message is on its way. I'll get back to you soon.</p>
    <a href="/" class="label mx-auto mt-10 rounded-full bg-ink px-7 py-4 text-paper">Back home</a>
  </section>
</Base>
