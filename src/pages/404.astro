    <h1 class="display text-[10rem] leading-none">404</h1>
    <p class="mt-4 text-xl">This page wandered off.</p>
    <a href="/" class="label mx-auto mt-10 rounded-full bg-ink px-7 py-4 text-paper">Back home</a>
  </section>
</Base>
