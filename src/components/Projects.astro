---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/site';
---

<section id="projects" class="container-x border-t border-line py-20 sm:py-28">
  <SectionHeading index="04" eyebrow="Selected work" title="Projects" />

  <div class="mt-14 grid gap-6 md:grid-cols-2">
    {projects.map((p, i) => (
      <article class="group flex flex-col overflow-hidden rounded-3xl bg-card text-card-ink" data-reveal>
        <div class="overflow-hidden">
          <img
            src={p.image}
            alt={`Screenshot of ${p.title}`}
            class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            loading="lazy"
            width="800"
            height="500"
          />
        </div>
        <div class="flex flex-1 flex-col p-7 sm:p-8">
          <div class="label flex justify-between opacity-70">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{p.context}</span>
          </div>
          <h3 class="display mt-4 text-4xl sm:text-5xl">{p.title}</h3>
          <p class="mt-3 opacity-80">{p.summary}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <li class="label rounded-full border border-white/20 px-3 py-1.5 opacity-90">{t}</li>
            ))}
          </ul>
          <div class="mt-auto flex flex-wrap gap-5 pt-7">
            {p.links.map((l) => (
              <a href={l.href} class="label text-accent hover:underline">{l.label} ↗</a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
