---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/site';
---

<section id="skills" class="container-x border-t border-line py-20 sm:py-28">
  <SectionHeading index="01" eyebrow="Toolbox" title="Skills & Tools" />

  <div class="mt-14">
    {skills.map((g) => (
      <div class="grid gap-4 border-t border-line py-7 md:grid-cols-[14rem_1fr]" data-reveal>
        <h3 class="label pt-2 text-muted">{g.group}</h3>
        <ul class="flex flex-wrap gap-2.5">
          {g.items.map((item) => (
            <li class="label rounded-full border border-line bg-paper-2 px-4 py-2.5 transition-colors hover:border-ink">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
