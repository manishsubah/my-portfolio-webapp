---
import { site, stats, services } from '../data/site';
---

<section id="about" class="container-x border-t border-line py-20 sm:py-28">
  <dl class="grid grid-cols-2 gap-y-10 lg:grid-cols-4" data-reveal>
    {stats.map((s) => (
      <div class="border-l border-line pl-5">
        <dt class="label text-muted">{s.label}</dt>
        <dd class="display mt-2 text-6xl sm:text-7xl">{s.value}</dd>
      </div>
    ))}
  </dl>

  <p class="mt-20 max-w-4xl text-2xl leading-snug sm:text-3xl" data-reveal>{site.bio}</p>

  <ol class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
    {services.map((s, i) => (
      <li class="bg-paper p-7 sm:p-9" data-reveal>
        <span class="label text-accent">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="display mt-3 text-3xl sm:text-4xl">{s.title}</h3>
        <p class="mt-3 text-muted">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
