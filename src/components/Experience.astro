---
import { experience } from '../data/site';
---

<section id="experience" class="container-x grid gap-12 border-t border-line py-20 sm:py-28 lg:grid-cols-[1fr_2fr]">
  <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
    <p class="eyebrow mb-3 text-lg">(02) Career</p>
    <h2 class="display text-6xl sm:text-7xl">Work<br />Experience</h2>
  </div>

  <ol class="relative border-l border-line">
    {experience.map((job) => (
      <li class="relative pb-12 pl-8 last:pb-0" data-reveal>
        <span
          class:list={[
            'absolute top-2 -left-[7px] h-3.5 w-3.5 rounded-full border-2 border-paper',
            job.current ? 'bg-accent' : 'bg-ink',
          ]}
        ></span>
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="display text-3xl sm:text-4xl">{job.role}</h3>
          {job.current && <span class="label rounded-full bg-accent px-2.5 py-1 text-paper">Current</span>}
        </div>
        <p class="mt-1 font-sans text-sm text-muted">
          <strong class="font-semibold text-ink">{job.company}</strong> · {job.period} · {job.place}
        </p>
        <p class="mt-3 max-w-2xl leading-relaxed">{job.summary}</p>
      </li>
    ))}
  </ol>
</section>
